---
import Image from "astro/components/Image.astro";

interface props{
    title: string,
    comment: string,
    description: string,
	pic: object,
}

const { title, comment, description, pic } = Astro.props;
---
<div class="wrap">
    <div class="banner">
        <div class="title">
            <h2>{ title }</h2>
            <p>{ comment }</p>
        </div>
        <div class="pic">
            <Image
            src={ pic }
            alt={ title }
            class="picIn"
            />
        </div>
    </div>
    <div class="desc">
        <p>{ description }</p>
    </div>
</div>

<style>
    @reference "tailwindcss";

	.wrap{
		@apply
		min-h-lvh
		bg-neutral-900 text-white
	}

    .banner{
        @apply
        container
        flex flex-col md:flex-row
        md:max-h-[50lvh] md:min-h-120
        md:px-5 md:py-10
    }

    .title{
        @apply
        order-2 md:order-1
        flex flex-col
        justify-center items-center
        w-full md:w-2/5
        py-5
    }

    .pic{
        @apply
        order-1 md:order-2
        w-full md:w-3/5
        max-h-full
        overflow-hidden
        rounded-2xl
        border border-white
    }
    .picIn{
        @apply
        aspect-6/4
        h-full w-full
        object-cover
    }

    .desc{
        @apply
        container mx-auto
        p-5 md:px-10
        md:min-h-[5lh]
    }
</style>