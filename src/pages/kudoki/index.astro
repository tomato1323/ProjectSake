---
import Layout from '@/layouts/Layout.astro'
import Sake from '@/layouts/Sake.astro'
import kudoki from '@/assets/Best/Kudoki-jouzu.jpg'
---
<Layout title="Bar S くどき上手">
    <Sake
    title="くどき上手(くどきじょうず)　辛口吟醸"
    comment={`ー "辛くて旨い"の融合ー`}
    description="きりっと辛口なのに、旨味と甘みも感じられる。相反する要素が融合された新しいタイプのお酒です。後味がスッキリしているため、ごくごくと水のように飲んでしまいます。危ないです。パッケージには日本画が描かれており、日本酒らしい感じがしますね。"
    pic={ kudoki }
    />
</Layout>