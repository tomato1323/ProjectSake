---
import Layout from '@/layouts/Layout.astro'
import Sake from '@/layouts/Sake.astro'
import mikumo from '@/assets/Best/Mikumo.jpg'
---
<Layout title="Bar S 美雲">
    <Sake
    title="光栄菊　美雲(みくも)"
    comment={`ーずっと“イチゴの甘いところ”だけー`}
    description="キャッチコピーからも甘く飲みやすいお酒であることが想像つくと思います。これはほぼジュースです。お酒が苦手な人が気になる、苦味や渋みなどはほとんどない優しいお酒。お店で飲んだ時に感動し、その後自宅用に購入しました。パッケージもピンク色で可愛くお気に入りのお酒です。"
    pic={ mikumo }
    />
</Layout>